# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://youdo:youdo123@localhost:5432/youdo_v2"

# ============================================
# Redis Configuration
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# JWT Configuration
# Generate with: openssl rand -base64 64
# ============================================
JWT_SECRET="your-jwt-secret-here-change-in-production"

# ============================================
# SSO Hub Configuration
# ============================================
SSO_HUB_URL="https://hub.youdobrasil.com.br"
SSO_HUB_SECRET="your-sso-hub-secret"

# ============================================
# UERP API Configuration
# ============================================
UERP_API_URL="https://userpweb.youdobrasil.com.br"
UERP_API_TOKEN="your-uerp-token"

# ============================================
# AWS S3 Configuration
# ============================================
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="youdo-v2-uploads"
AWS_REGION="sa-east-1"

# ============================================
# Twilio Configuration (WhatsApp)
# ============================================
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ============================================
# Resend Configuration (Email)
# ============================================
RESEND_API_KEY="your-resend-api-key"

# ============================================
# Sentry Configuration (Error Tracking)
# ============================================
SENTRY_DSN="your-sentry-dsn"

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ============================================
# Node Environment
# ============================================
NODE_ENV="development"
PORT="3001"
