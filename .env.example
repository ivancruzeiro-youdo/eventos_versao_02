# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://youdo:youdo123@localhost:5432/youdo_v2"

# ============================================
# Redis Configuration
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# JWT Configuration
# Generate with: openssl rand -base64 64
# ============================================
JWT_SECRET="your-jwt-secret-here-change-in-production"

# ============================================
# SSO Hub Configuration
# ============================================
SSO_HUB_URL="https://hub.youdobrasil.com.br"
SSO_HUB_SECRET="your-sso-hub-secret"

# ============================================
# UERP API Configuration
# ============================================
UERP_API_URL="https://userpweb.youdobrasil.com.br"
UERP_API_TOKEN="your-uerp-token"

# ============================================
# AWS S3 Configuration
# ============================================
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="youdo-eventos-uploads"
AWS_REGION="us-east-1"

# ============================================
# YouDoChat (WhatsApp — alertas automáticos, ex: atividade atrasada)
# Chave em /opt/youdochat/.env (PUBLIC_API_KEY) no servidor do YouDoChat —
# ver apps/api/src/lib/youdochat.ts. Substitui o antigo webhook n8n/Chatwoot.
# ============================================
YOUDOCHAT_API_KEY="your-youdochat-public-api-key"

# ============================================
# Resend Configuration (Email)
# ============================================
RESEND_API_KEY="your-resend-api-key"

# ============================================
# Sentry Configuration (Error Tracking)
# ============================================
SENTRY_DSN="your-sentry-dsn"

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ============================================
# Spotify (integração por espaço — painel de LED, Fase 3)
# App em https://developer.spotify.com/dashboard — Redirect URI tem que ser
# exatamente "$API_URL/api/v2/spotify/callback" (cadastrado no dashboard do app).
# ============================================
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REDIRECT_URI="http://localhost:3001/api/v2/spotify/callback"
# Chave usada pra criptografar (AES-256-GCM) o refresh token de cada espaço em repouso —
# qualquer string longa e aleatória serve, gere com: openssl rand -base64 32
SPOTIFY_TOKEN_ENCRYPTION_KEY="your-random-encryption-key"

# ============================================
# Integração com Sistema de Acessos
# ============================================
ACESSOS_API_URL="https://acessos.youdobrasil.com.br"
ACESSOS_API_EMAIL="integracao@suaempresa.com.br"
ACESSOS_API_PASSWORD="your-acessos-password"

# ============================================
# Node Environment
# ============================================
NODE_ENV="development"
PORT="3001"
