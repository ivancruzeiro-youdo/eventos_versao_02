generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Entidades de Usuários e Autenticação
// ============================================

enum UserRole {
  admin
  event_owner
  operator
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  role        UserRole
  employerId  String?
  userpCodigo String?  @unique
  userpTipo   String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer    Employer?   @relation(fields: [employerId], references: [id])
  auditLogs     AuditLog[]
  checkins      Guest[]     @relation("CheckedInBy")
  penaltiesApplied FreelancerPenalty[] @relation("AppliedBy")
  checklistItems ChecklistItem[] @relation("DoneBy")
  comments         EventComment[]
  deletedComments  EventComment[]   @relation("CommentDeletedBy")
  uploadedFiles File[] @relation("uploadedBy")
  choiceConfirmed       EventItemChoice[]         @relation("ChoiceConfirmedBy")
  choiceHistories       EventItemChoiceHistory[]   @relation("ChoiceHistoryUser")
  itemAnswers           EventItemAnswer[]          @relation("AnswerUpdatedBy")
  itemAnswerHistories   EventItemAnswerHistory[]   @relation("AnswerHistoryUser")
  venueAnswers         EventVenueAnswer[]         @relation("VenueAnswerUpdatedBy")
  venueAnswerHistories EventVenueAnswerHistory[]  @relation("VenueAnswerHistoryUser")
  activitiesCreated   EventActivity[]            @relation("ActivityCreatedBy")
  activitiesAssigned  EventActivity[]            @relation("ActivityAssignedTo")
  activitiesCompleted EventActivity[]            @relation("ActivityCompletedBy")

  @@index([email])
  @@index([employerId])
  @@index([userpCodigo])
}

model Freelancer {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  cpf          String           @unique
  phone        String?
  birthDate    DateTime?
  passwordHash String?
  status       FreelancerStatus @default(active)
  strikeCount  Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  fotoBase64   String?
  applications FreelancerApplication[]
  penalties    FreelancerPenalty[]
  services     FreelancerServiceLink[]
  acessoLogs   AcessoLog[]

  @@index([email])
  @@index([cpf])
}

model FreelancerService {
  id                  String   @id @default(uuid())
  name                String
  hourlyRate          Float    @default(0)
  description         String?
  startOffsetMinutes  Int      @default(-60)
  endOffsetMinutes    Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  freelancers    FreelancerServiceLink[]
  products       ProductServiceLink[]
  eventServices  EventService[]
  acessoMappings ServiceAcessoMapping[]
}

model FreelancerServiceLink {
  id           String   @id @default(uuid())
  freelancerId String
  serviceId    String
  createdAt    DateTime @default(now())

  freelancer Freelancer        @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  service    FreelancerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, serviceId])
  @@index([freelancerId])
  @@index([serviceId])
}

model ProductServiceLink {
  id        String   @id @default(uuid())
  productId String
  serviceId String
  createdAt DateTime @default(now())

  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  service FreelancerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([productId, serviceId])
  @@index([productId])
  @@index([serviceId])
}

enum FreelancerStatus {
  active
  suspended
}

model Employer {
  id           String   @id @default(uuid())
  name         String
  cnpj         String?  @unique
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users   User[]
  events  Event[]
  venues  Venue[]
  services Service[]
  people  Person[]

  kitchenIngredients     KitchenIngredient[]
  kitchenRecipes         KitchenRecipe[]
  kitchenPurchases       KitchenPurchaseRecord[]
  kitchenLaborRoles      KitchenLaborRole[]
  kitchenEventPlans      KitchenEventPlan[]
  kitchenBatches         KitchenProductionBatch[]
  kitchenProductionPlans KitchenProductionPlan[]

  @@index([cnpj])
}

// ============================================
// Entidades de Eventos
// ============================================

enum EventStatus {
  draft
  confirmed
  in_progress
  completed
  encerrado
  cancelled
}

model Event {
  id                String      @id @default(uuid())
  name              String
  clientName        String
  employerId        String
  status            EventStatus @default(draft)
  setupAt           DateTime?
  startAt           DateTime?
  teardownAt        DateTime?
  notes             String?
  clientToken       String?     @unique
  reservationNumber String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  employer     Employer     @relation(fields: [employerId], references: [id])
  venues       EventVenue[]
  guests       Guest[]
  services     EventService[]
  plan         EventPlan?
  briefing     Briefing?
  checklists   EventChecklist[]
  applications FreelancerApplication[]
  nps          EventNPS[]
  files        File[]
  comments     EventComment[]
  schedules    EventSchedule[]
  contracts    EventContract[]
  items        EventItem[]
  syncLogs        EventSyncLog[]  @relation("EventToSyncLog")
  venueAnswers    EventVenueAnswer[]
  closure         EventClosure?
  members         EventMember[]
  npsOrganizador  EventNPSOrganizador?
  clientApprovals ClientApproval[]

  activities            EventActivity[]
  layouts               EventLayout[]
  kitchenMenus          KitchenEventMenu[]
  kitchenLabors         KitchenEventLabor[]
  productions           KitchenProductionLog[]
  kitchenPlan           KitchenEventPlan?
  batchAllocations      KitchenBatchAllocation[]
  productionAllocations KitchenProductionAllocation[]

  @@index([employerId])
  @@index([status])
  @@index([startAt])
}

model EventVenue {
  id       String @id @default(uuid())
  eventId  String
  venueId  String
  notes    String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id])

  @@index([eventId])
  @@index([venueId])
}

model Venue {
  id             String   @id @default(uuid())
  externalId     String?  @unique
  name           String
  address        String?
  city           String?
  state          String?
  capacity       Int?
  contactName    String?
  contactPhone   String?
  employerId     String
  floorPlanS3Key        String?
  floorPlanWidthMeters  Float?
  floorPlanHeightMeters Float?
  layoutStock           Json?
  createdAt             DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employer         Employer               @relation(fields: [employerId], references: [id])
  events           EventVenue[]
  questions        VenueQuestion[]
  layoutTemplates  VenueLayoutTemplate[]

  @@index([employerId])
}

model VenueLayoutTemplate {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  elements  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model VenueQuestion {
  id        String       @id @default(uuid())
  venueId   String
  text      String
  type      QuestionType
  required  Boolean      @default(false)
  options   Json?
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  venue   Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  answers EventVenueAnswer[]

  @@index([venueId])
}

model EventVenueAnswer {
  id         String    @id @default(uuid())
  eventId    String
  questionId String
  answer     Json
  updatedAt  DateTime  @updatedAt
  updatedById String?

  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question   VenueQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  updatedBy  User?         @relation("VenueAnswerUpdatedBy", fields: [updatedById], references: [id])
  history    EventVenueAnswerHistory[]

  @@unique([eventId, questionId])
  @@index([eventId])
}

model EventVenueAnswerHistory {
  id        String   @id @default(uuid())
  answerId  String
  before    Json?
  after     Json
  userId    String?
  createdAt DateTime @default(now())

  answer EventVenueAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User?            @relation("VenueAnswerHistoryUser", fields: [userId], references: [id])

  @@index([answerId])
}

// ============================================
// Entidades de Convidados
// ============================================

enum GuestStatus {
  pending
  confirmed
  declined
  waitlisted
  checked_in
}

model Guest {
  id               String      @id @default(uuid())
  eventId          String
  name             String
  phone            String?
  cpf              String?
  email            String?
  status           GuestStatus @default(pending)
  rsvpToken        String?     @unique
  rsvpRespondedAt  DateTime?
  checkedInAt      DateTime?
  checkedInByUserId String?
  isMinor          Boolean     @default(false)
  responsibleName  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInBy User?   @relation("CheckedInBy", fields: [checkedInByUserId], references: [id])
  nps       EventNPS?

  @@index([eventId])
  @@index([status])
  @@index([cpf])
  @@index([rsvpToken])
}

// ============================================
// Entidades de Freelancers
// ============================================

model FreelancerApplication {
  id           String                   @id @default(uuid())
  freelancerId String
  eventId      String
  role         String
  status       ApplicationStatus      @default(pending)
  appliedAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  freelancer Freelancer @relation(fields: [freelancerId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  acessoLogs AcessoLog[]

  @@index([freelancerId])
  @@index([eventId])
  @@index([status])
}

// ============================================
// Integração com Sistema de Acessos
// ============================================

model ServiceAcessoMapping {
  id         String   @id @default(uuid())
  serviceId  String
  acessoId   String
  acessoNome String?
  createdAt  DateTime @default(now())

  service FreelancerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, acessoId])
  @@index([serviceId])
}

model AcessoLog {
  id              String   @id @default(uuid())
  freelancerId    String
  applicationId   String
  acessoExternoId String?
  status          String
  payload         Json?
  response        Json?
  createdAt       DateTime @default(now())

  freelancer  Freelancer            @relation(fields: [freelancerId], references: [id])
  application FreelancerApplication @relation(fields: [applicationId], references: [id])

  @@index([freelancerId])
  @@index([applicationId])
  @@index([status])
}

enum ApplicationStatus {
  pending
  approved
  rejected
  cancelled
}

model FreelancerPenalty {
  id            String   @id @default(uuid())
  freelancerId  String
  eventId       String?
  reason        String
  severity      PenaltySeverity
  appliedByUserId String
  createdAt     DateTime @default(now())

  freelancer Freelancer @relation(fields: [freelancerId], references: [id])
  appliedBy  User       @relation("AppliedBy", fields: [appliedByUserId], references: [id])

  @@index([freelancerId])
}

enum PenaltySeverity {
  light
  medium
  grave
}

// ============================================
// Entidades de Planos
// ============================================

model EventPlan {
  id        String     @id @default(uuid())
  eventId   String     @unique
  title     String
  status    PlanStatus @default(draft)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions PlanQuestion[]
}

enum PlanStatus {
  draft
  completed
}

model PlanQuestion {
  id        String           @id @default(uuid())
  planId    String
  text      String
  type      QuestionType
  required  Boolean          @default(false)
  order     Int
  productId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  plan    EventPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  answers PlanAnswer[]

  @@index([planId])
}

enum QuestionType {
  text
  textarea
  select
  multiselect
  checkbox
  date
  number
}

model PlanAnswer {
  id              String   @id @default(uuid())
  questionId      String
  textValue       String?
  selectedOptions Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question PlanQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ============================================
// Entidades de Briefing
// ============================================

model Briefing {
  id         String          @id @default(uuid())
  eventId    String          @unique
  templateId String?
  status     BriefingStatus  @default(draft)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions BriefingQuestion[]
}

enum BriefingStatus {
  draft
  completed
}

model BriefingQuestion {
  id         String           @id @default(uuid())
  briefingId String
  text       String
  type       QuestionType
  required   Boolean          @default(false)
  order      Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  briefing Briefing        @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  answers  BriefingAnswer[]

  @@index([briefingId])
}

model BriefingAnswer {
  id         String   @id @default(uuid())
  questionId String
  value      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question BriefingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ============================================
// Entidades de Serviços
// ============================================

model Service {
  id          String   @id @default(uuid())
  name        String
  category    String?
  description String?
  employerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer Employer? @relation(fields: [employerId], references: [id])
}

model EventService {
  id           String    @id @default(uuid())
  eventId      String
  serviceId    String
  productName  String?
  notes        String?
  status       String    @default("active")
  startAt      DateTime?
  endAt        DateTime?
  valuePerHour Float     @default(0)
  maxSlots     Int       @default(1)
  createdAt    DateTime  @default(now())

  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service         FreelancerService       @relation(fields: [serviceId], references: [id])
  files           File[]
  linkedChecklists EventServiceChecklist[]

  @@index([eventId])
  @@index([serviceId])
}

model EventServiceChecklist {
  serviceId   String
  checklistId String

  service   EventService   @relation(fields: [serviceId],   references: [id], onDelete: Cascade)
  checklist EventChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@id([serviceId, checklistId])
}

// ============================================
// Entidades de Checklists
// ============================================

model EventChecklist {
  id         String   @id @default(uuid())
  eventId    String
  title      String
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items           ChecklistItem[]
  linkedServices  EventServiceChecklist[]

  @@index([eventId])
}

model ChecklistItem {
  id            String    @id @default(uuid())
  checklistId   String
  text          String
  done          Boolean   @default(false)
  doneAt        DateTime?
  doneByUserId  String?
  order         Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checklist EventChecklist? @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy    User?      @relation("DoneBy", fields: [doneByUserId], references: [id])

  @@index([checklistId])
}

model ChecklistTemplate {
  id          String                  @id @default(uuid())
  title       String
  employerId  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  items ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id          String            @id @default(uuid())
  templateId  String
  text        String
  order       Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// ============================================
// Entidades de NPS
// ============================================

model EventNPS {
  id          String   @id @default(uuid())
  eventId     String
  guestId     String   @unique
  score       Int?
  comment     String?
  submittedAt DateTime?
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ============================================
// Entidades de Cronograma
// ============================================

model EventSchedule {
  id          String   @id @default(uuid())
  eventId     String
  teamId      String?
  name        String
  startAt     DateTime
  endAt       DateTime
  description String?
  fileId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team?          @relation(fields: [teamId], references: [id])
  file    File?          @relation("ScheduleFile", fields: [fileId], references: [id])
  history EventComment[]

  @@index([eventId])
  @@index([teamId])
  @@index([startAt])
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules EventSchedule[]
}

// ============================================
// Entidades de Arquivos e Logs
// ============================================

model File {
  id               String   @id @default(uuid())
  eventId          String
  serviceId        String?
  uploadedByUserId String?
  name             String
  mimeType         String
  sizeBytes        Int
  s3Key            String
  comment          String?
  visibleToClient  Boolean  @default(false)
  createdAt        DateTime @default(now())

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service     EventService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploadedBy  User?         @relation("uploadedBy", fields: [uploadedByUserId], references: [id])
  schedules   EventSchedule[] @relation("ScheduleFile")

  @@index([eventId])
  @@index([serviceId])
}

// ============================================
// Entidades de Comentários
// ============================================

model EventComment {
  id              String    @id @default(uuid())
  eventId         String
  eventItemId     String?   // null = event-level comment; set = item-level comment
  eventScheduleId String?   // set = schedule history entry
  userId          String?   // null for system auto-comments
  isSystem        Boolean   @default(false)
  content         String
  deletedAt       DateTime? // soft-delete: keeps record in history
  deletedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventItem     EventItem?     @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  eventSchedule EventSchedule? @relation(fields: [eventScheduleId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id])
  deletedBy     User?          @relation("CommentDeletedBy", fields: [deletedById], references: [id])

  @@index([eventId])
  @@index([eventItemId])
  @@index([eventScheduleId])
  @@index([userId])
}

model ClientApproval {
  id         String   @id @default(uuid())
  eventId    String
  itemType   String   // 'plan' | 'schedule'
  itemId     String
  approvedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, itemType, itemId])
  @@index([eventId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

// ============================================
// Entidades de Templates
// ============================================

model TemplateQuestion {
  id          String       @id @default(uuid())
  text        String
  type        QuestionType
  required    Boolean      @default(false)
  productId   String?
  categoryId  String?
  employerId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BriefingTemplate {
  id         String   @id @default(uuid())
  title      String
  employerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  questions BriefingTemplateQuestion[]
}

model BriefingTemplateQuestion {
  id         String   @id @default(uuid())
  templateId String
  text       String
  type       QuestionType
  required   Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template BriefingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// ============================================
// Plan Templates
// ============================================

model PlanTemplate {
  id          String   @id @default(uuid())
  title       String
  description String?
  employerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions PlanTemplateQuestion[]

  @@index([employerId])
}

model PlanTemplateQuestion {
  id         String       @id @default(uuid())
  templateId String
  text       String
  type       QuestionType
  required   Boolean      @default(false)
  category   String?
  options    Json?
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  template PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ============================================
// Produtos (importados do Userp-Satélite)
// ============================================

model Product {
  id              String   @id @default(uuid())
  externalId      String   @unique
  name            String
  descriptionLong String?
  subitems        Json?
  price           Float?
  categoryId      String?
  categoryName    String?
  unitId          String?
  unitName        String?
  unitAbbr        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions  ProductQuestion[]
  services   ProductServiceLink[]
  eventItems EventItem[]

  kitchenRecipes KitchenRecipe[]

  @@index([categoryName])
}

model ProductQuestion {
  id        String       @id @default(uuid())
  productId String
  text      String
  type      QuestionType
  required  Boolean      @default(false)
  options   Json?
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  answers EventItemAnswer[]

  @@index([productId])
}

// ============================================
// Importação de Contratos Userp
// ============================================

model EventContract {
  id              String   @id @default(uuid())
  eventId         String
  externalId      String   // contrato_id from Userp
  clientCode      String   // cliente_codigo
  startDate       String   // data_inicio (YYYY-MM-DD) — matches events
  rawJson         Json     // full contract payload snapshot
  createdAt       DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([clientCode, startDate])
}

// Item contratado dentro de um evento (A&B, Infraestrutura, Equipe, Locação)
model EventItem {
  id               String   @id @default(uuid())
  eventId          String
  productId        String?  // linked Product (null for venue items)
  venueId          String?  // linked Venue (for locação)
  sourceContractId String?  // external contract ID that contributed this item
  category         String   // "ab" | "infra" | "staff" | "venue"
  name             String
  quantity         Float    @default(1)
  unit             String?
  notes            String?
  occurrenceIndex  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product  Product?       @relation(fields: [productId], references: [id])
  choices  EventItemChoice[]
  slots    EventStaffSlot[]
  answers  EventItemAnswer[]
  comments EventComment[]

  kitchenMenuLink KitchenEventMenu[]

  @@index([eventId])
  @@index([productId])
}

// Escolhas feitas pelo cliente dentro de um item (ex: pratos selecionados)
model EventItemChoice {
  id            String    @id @default(uuid())
  eventItemId   String
  label         String    // subitem group label
  chosen        String[]  // chosen options from subitems
  maxChoices    Int?
  confirmedAt   DateTime?
  confirmedById String?

  eventItem   EventItem               @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  confirmedBy User?                   @relation("ChoiceConfirmedBy", fields: [confirmedById], references: [id])
  history     EventItemChoiceHistory[]

  @@index([eventItemId])
}

// Histórico de alterações em escolhas
model EventItemChoiceHistory {
  id        String   @id @default(uuid())
  choiceId  String
  before    String[] // previous chosen values
  after     String[] // new chosen values
  userId    String?
  createdAt DateTime @default(now())

  choice EventItemChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  user   User?           @relation("ChoiceHistoryUser", fields: [userId], references: [id])

  @@index([choiceId])
  @@index([createdAt])
}

// Respostas às perguntas de configuração de um item
model EventItemAnswer {
  id          String   @id @default(uuid())
  eventItemId String
  questionId  String
  answer      Json     // string | string[]
  updatedAt   DateTime @updatedAt
  updatedById String?

  eventItem   EventItem       @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  question    ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  updatedBy   User?           @relation("AnswerUpdatedBy", fields: [updatedById], references: [id])
  history     EventItemAnswerHistory[]

  @@unique([eventItemId, questionId])
  @@index([eventItemId])
}

// Histórico de alterações em respostas
model EventItemAnswerHistory {
  id        String   @id @default(uuid())
  answerId  String
  before    Json?
  after     Json
  userId    String?
  createdAt DateTime @default(now())

  answer EventItemAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User?           @relation("AnswerHistoryUser", fields: [userId], references: [id])

  @@index([answerId])
  @@index([createdAt])
}

// Vaga de freelancer criada a partir de item do tipo "staff"
model EventStaffSlot {
  id            String   @id @default(uuid())
  eventItemId   String
  serviceId     String   // FreelancerService
  quantity      Int      @default(1)
  filledCount   Int      @default(0)
  createdAt     DateTime @default(now())

  eventItem EventItem @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  @@index([eventItemId])
}

// Log de versão: toda sync gera um registro
model EventSyncLog {
  id          String   @id @default(uuid())
  eventId     String?
  action      String
  diff        Json?
  syncedAt    DateTime @default(now())
  triggeredBy String?

  event Event? @relation("EventToSyncLog", fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

// ============================================
// Módulo Cozinha
// ============================================

enum KitchenStorageType {
  dry
  frozen
  refrigerated
}

enum KitchenMenuType {
  guest
  staff
}

enum KitchenPurchaseSource {
  foto
  manual
}

model KitchenIngredient {
  id            String             @id @default(uuid())
  employerId    String
  name          String
  category      String
  unit          String
  costPerUnit   Float              @default(0)
  stockQuantity Float              @default(0)
  minQuantity   Float              @default(0)
  storageType   KitchenStorageType @default(dry)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  employer          Employer                  @relation(fields: [employerId], references: [id])
  recipeIngredients KitchenRecipeIngredient[]
  purchaseItems     KitchenPurchaseItem[]

  @@unique([employerId, name, unit])
  @@index([employerId])
}

model KitchenRecipe {
  id              String   @id @default(uuid())
  employerId      String
  productId       String?
  name            String
  category        String
  recipeType      String   @default("final") // 'base' | 'final'
  servings        Int      @default(1)
  averagePerGuest Float    @default(0)
  prepTime        Int      @default(0)
  validityHours   Int      @default(48) // hours recipe is good after production
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employer          Employer                    @relation(fields: [employerId], references: [id])
  product           Product?                    @relation(fields: [productId], references: [id])
  ingredients       KitchenRecipeIngredient[]
  subRecipes        KitchenSubRecipe[]          @relation("ParentRecipe")
  parentRecipes     KitchenSubRecipe[]          @relation("SubRecipe")
  steps             KitchenRecipeStep[]
  eventMenus        KitchenEventMenu[]
  productions       KitchenProductionLog[]
  productionBatches KitchenProductionBatch[]
  planItems         KitchenProductionPlanItem[]

  @@index([employerId])
  @@index([productId])
}

model KitchenRecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String

  recipe     KitchenRecipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient KitchenIngredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
}

model KitchenSubRecipe {
  id           String @id @default(uuid())
  parentId     String
  subRecipeId  String
  servingsUsed Float  @default(1)

  parent    KitchenRecipe @relation("ParentRecipe", fields: [parentId], references: [id], onDelete: Cascade)
  subRecipe KitchenRecipe @relation("SubRecipe", fields: [subRecipeId], references: [id])

  @@unique([parentId, subRecipeId])
  @@index([parentId])
}

model KitchenRecipeStep {
  id       String  @id @default(uuid())
  recipeId String
  order    Int
  text     String
  imageKey String?

  recipe KitchenRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model KitchenEventMenu {
  id             String          @id @default(uuid())
  eventId        String
  recipeId       String
  eventItemId    String?
  menuType       KitchenMenuType @default(guest)
  servingsNeeded Int             @default(0)
  leftovers      Float?
  breakage       Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipe    KitchenRecipe @relation(fields: [recipeId], references: [id])
  eventItem EventItem?    @relation(fields: [eventItemId], references: [id])

  @@unique([eventId, recipeId, menuType])
  @@index([eventId])
}

model KitchenProductionLog {
  id               String   @id @default(uuid())
  eventId          String
  recipeId         String
  portionsProduced Float
  producedAt       DateTime
  notes            String?
  createdAt        DateTime @default(now())

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipe KitchenRecipe @relation(fields: [recipeId], references: [id])

  @@index([eventId])
  @@index([recipeId])
}

model KitchenPurchaseRecord {
  id          String                @id @default(uuid())
  employerId  String
  eventId     String?
  storeName   String
  date        DateTime
  totalAmount Float                 @default(0)
  source      KitchenPurchaseSource @default(manual)
  createdAt   DateTime              @default(now())

  employer Employer              @relation(fields: [employerId], references: [id])
  items    KitchenPurchaseItem[]

  @@index([employerId])
  @@index([eventId])
}

model KitchenPurchaseItem {
  id               String  @id @default(uuid())
  purchaseRecordId String
  ingredientId     String?
  productName      String
  quantity         Float
  unit             String
  unitPrice        Float
  totalPrice       Float

  purchaseRecord KitchenPurchaseRecord @relation(fields: [purchaseRecordId], references: [id], onDelete: Cascade)
  ingredient     KitchenIngredient?    @relation(fields: [ingredientId], references: [id])

  @@index([purchaseRecordId])
}

model KitchenLaborRole {
  id         String   @id @default(uuid())
  employerId String
  name       String
  dailyRate  Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employer    Employer            @relation(fields: [employerId], references: [id])
  eventLabors KitchenEventLabor[]

  @@unique([employerId, name])
  @@index([employerId])
}

model KitchenEventLabor {
  id          String   @id @default(uuid())
  eventId     String
  laborRoleId String
  quantity    Int      @default(1)
  days        Int      @default(1)
  createdAt   DateTime @default(now())

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  laborRole KitchenLaborRole @relation(fields: [laborRoleId], references: [id])

  @@unique([eventId, laborRoleId])
  @@index([eventId])
}

// ============================================
// Kitchen Production Pipeline
// ============================================

// Kitchen planning status per event
// Status flow: pending → shopping_approved → planned → in_production → done
model KitchenEventPlan {
  id         String   @id @default(uuid())
  eventId    String   @unique
  employerId String
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employer Employer @relation(fields: [employerId], references: [id])

  @@index([employerId])
  @@index([status])
}

// A production run for one recipe; can cover multiple events (unified pre-prep)
model KitchenProductionBatch {
  id          String   @id @default(uuid())
  employerId  String
  recipeId    String
  phase       String // 'pre_prep' | 'day_of'
  scheduledAt DateTime
  targetQty   Float // total portions to produce
  producedQty Float    @default(0)
  status      String   @default("planned") // planned | in_progress | done
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer    Employer                 @relation(fields: [employerId], references: [id])
  recipe      KitchenRecipe            @relation(fields: [recipeId], references: [id])
  allocations KitchenBatchAllocation[]

  @@index([employerId])
  @@index([recipeId])
  @@index([scheduledAt])
}

// Portion split of a batch across events
model KitchenBatchAllocation {
  id       String  @id @default(uuid())
  batchId  String
  eventId  String
  menuId   String?
  quantity Float // portions for this event

  batch KitchenProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  event Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([batchId, eventId])
  @@index([batchId])
  @@index([eventId])
}

// ============================================
// Kitchen AI Production Plan
// ============================================

// A plan covers N days ahead and groups all recipe production needed
model KitchenProductionPlan {
  id         String   @id @default(uuid())
  employerId String
  status     String   @default("draft") // draft | approved | in_progress | done
  windowDays Int      @default(30) // days ahead this plan covers
  aiModel    String?
  aiNotes    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employer Employer                    @relation(fields: [employerId], references: [id])
  items    KitchenProductionPlanItem[]

  @@index([employerId])
  @@index([status])
  @@index([createdAt])
}

// One production run for one recipe on one date
model KitchenProductionPlanItem {
  id            String   @id @default(uuid())
  planId        String
  recipeId      String
  quantity      Float // total portions to produce
  scheduledDate DateTime
  phase         String // pre_prep | day_of
  estimatedCost Float    @default(0)
  validityHours Int      @default(48)
  reasoning     String?
  status        String   @default("pending") // pending | done
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan        KitchenProductionPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe      KitchenRecipe                 @relation(fields: [recipeId], references: [id])
  allocations KitchenProductionAllocation[]

  @@index([planId])
  @@index([recipeId])
  @@index([scheduledDate])
}

// Maps each plan item to the events it serves (for per-event cost)
model KitchenProductionAllocation {
  id         String @id @default(uuid())
  planItemId String
  eventId    String
  quantity   Float // portions for this event
  costShare  Float  @default(0) // R$ cost allocated to this event

  planItem KitchenProductionPlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  event    Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([planItemId, eventId])
  @@index([planItemId])
  @@index([eventId])
}

// ============================================
// Configurações de Integração
// ============================================

model UerpConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

// ============================================
// Encerramento de Evento e NPS Organizador
// ============================================

model EventClosure {
  id                  String   @id @default(uuid())
  eventId             String   @unique
  itensQuebrados      String?
  situacoesReportadas String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event          Event               @relation(fields: [eventId], references: [id])
  attachments    ClosureAttachment[]
  npsOrganizador EventNPSOrganizador?

  @@index([eventId])
}

model ClosureAttachment {
  id         String   @id @default(uuid())
  closureId  String
  filename   String
  mimeType   String
  sizeBytes  Int
  dataBase64 String
  createdAt  DateTime @default(now())

  closure EventClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)

  @@index([closureId])
}

model EventNPSOrganizador {
  id             String    @id @default(uuid())
  closureId      String    @unique
  eventId        String    @unique
  token          String    @unique @default(uuid())
  score          Int?
  comentario     String?
  imagemBase64   String?
  respondenteName String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())

  closure EventClosure @relation(fields: [closureId], references: [id])
  event   Event        @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([token])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  responsavel String?
  contato     String?
  atendimento String?
  entrega     String?
  insumos     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// ============================================
// Pessoas do Evento (cadastro central)
// ============================================

model Person {
  id         String   @id @default(uuid())
  employerId String
  name       String
  cpf        String
  whatsapp   String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employer          Employer        @relation(fields: [employerId], references: [id])
  eventLinks        EventMember[]
  activitiesAssigned EventActivity[] @relation("ActivityAssignedPerson")

  @@unique([employerId, cpf])
  @@index([employerId])
  @@index([cpf])
}

model EventMember {
  id        String   @id @default(uuid())
  eventId   String
  personId  String
  role      String
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([eventId])
}

// ============================================
// Atividades do Evento
// ============================================

model EventActivity {
  id            String    @id @default(uuid())
  eventId         String
  title           String
  description     String?
  assignedToId    String?
  assignedPersonId String?
  createdById     String?
  dueAt           DateTime?
  status          String    @default("open")
  completedAt     DateTime?
  completedById   String?
  response        String?
  lastAlertAt     DateTime?
  alertFreqMinutes Int      @default(30)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedTo     User?               @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])
  assignedPerson Person?             @relation("ActivityAssignedPerson", fields: [assignedPersonId], references: [id])
  createdBy      User?               @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  completedBy    User?               @relation("ActivityCompletedBy", fields: [completedById], references: [id])
  files          EventActivityFile[]

  @@index([eventId])
  @@index([status])
  @@index([assignedPersonId])
}

model EventActivityFile {
  id         String        @id @default(uuid())
  activityId String
  name       String
  mimeType   String
  sizeBytes  Int
  s3Key      String
  createdAt  DateTime      @default(now())

  activity EventActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model EventLayout {
  id          String   @id @default(uuid())
  eventId     String
  name        String   @default("Layout Padrão")
  elements    Json
  createdById String?
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventLayoutConfig {
  id        String   @id @default("default")
  config    Json
  updatedAt DateTime @updatedAt
}
