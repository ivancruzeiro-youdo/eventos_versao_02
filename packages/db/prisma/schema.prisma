}

model BriefingTemplate {
  id         String   @id @default(uuid())
  title      String
  employerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  questions BriefingTemplateQuestion[]
}

model BriefingTemplateQuestion {
