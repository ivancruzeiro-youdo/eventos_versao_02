// ============================================
// TELA COZINHA — plano de serviço (display tipo KDS)
// ============================================

// Sequência de saídas de comida de um evento, montada na TELA COZINHA.
// Um plano por EVENTO (não por espaço): os itens de A&B não são escopados por espaço —
// EventItem.venueId é nulo para category='ab' (só category='venue' preenche). O espaço
// escolhido na tela decide apenas qual evento aparece em qual coluna.
model KitchenServicePlan {
  id              String    @id @default(uuid())
  eventId         String    @unique
  intervalMinutes Int       @default(15)
  anchorAt        DateTime? // horário de início do serviço — base pra gerar a sequência
  endAt           DateTime? // horário de fim do serviço — só exibido, não gera itens
  notes           String?
  // PAUSA DE SERVIÇO — motivo obrigatório + duração pré-determinada (5/10/15/20/30 min). Ao
  // pausar, toda entrada `status='pending'` é deslocada pra frente pela duração inteira (mesmo
  // delta-shift do bloco `anchorAt` acima) — a pausa não "roda" enquanto ativa, só desloca a
  // sequência uma vez, na criação. `pauseUntil` nunca é reajustado durante a pausa: é ele que
  // permite calcular, na retomada antecipada, quanto tempo não foi usado (`pauseUntil - now`)
  // pra devolver esse tanto à sequência. Sem cron/job: o fim automático é lido, não observado —
  // GET /service trata pauseUntil no passado como "sem pausa", mesmo que estas 3 colunas
  // continuem preenchidas até a próxima escrita (novo /pause, /resume, ou qualquer /plan) limpar.
  pausedAt        DateTime?
  pauseUntil      DateTime?
  pauseReason     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event   Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries KitchenServicePlanEntry[]
  logs    KitchenServicePlanLog[]
}

// Uma saída de um item. Duplicar um item (ex.: quiche às 20h e de novo às 21h30) = duas
// linhas com `round` diferente — por isso NÃO há unique em (planId, itemName, round); a
// idempotência da geração em lote é resolvida no endpoint, que checa itemName já presente.
model KitchenServicePlanEntry {
  id     String @id @default(uuid())
  planId String

  // Pacote de A&B de origem. SetNull e não Cascade: EventItem é apagado quando um contrato
  // desaparece do Userp (sync-events.ts, fluxo de confirm-removal), e a sequência montada à
  // mão pelo operador não deve evaporar junto — a linha fica órfã e a tela sinaliza.
  eventItemId String?
  sourceLabel String? // grupo de origem, ex.: "Entradas (escolher 4)"

  // Snapshot do nome: os itens escolhidos pelo cliente não têm identidade de linha — vivem
  // dentro de EventItemChoice.chosen (String[]) e EventItemAnswer.answer (Json). Se o cliente
  // trocar as escolhas, a entrada fica órfã (detectado por comparação no endpoint /service).
  itemName String

  // item        = uma saída de um item de comida (regra dos 15 min)
  // montagem / reposicao / desmontagem = pacote de estação (carrinho, buffet, coffee break,
  //   estação de massas): não faz sentido uma linha por item a cada 15 min, o que a cozinha
  //   precisa é montar, repor e desmontar. Ver classifyPackage em routes/kitchen-display.ts.
  entryKind String @default("item")

  serveAt           DateTime
  order             Int       @default(0)
  round             Int       @default(1)
  portionsPerPerson Float     @default(1)
  manualQuantity    Float? // override do operador, ignora o cálculo por pessoas
  status            String    @default("pending") // pending | served | skipped
  servedAt          DateTime?
  servedById        String? // sem relação, mesmo padrão de serviceTimesUpdatedById
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan      KitchenServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  eventItem EventItem?         @relation(fields: [eventItemId], references: [id], onDelete: SetNull)

  @@index([planId, order])
  @@index([eventItemId])
}

// Auditoria do plano de serviço: quem mexeu na sequência e quando. Tabela própria (e não
// EventComment) porque é log de operação da cozinha, com volume alto e granularidade fina —
// não deve poluir a timeline de comentários do evento.
// Mantida por planId com Cascade: se o evento for apagado, o log vai com ele.
model KitchenServicePlanLog {
  id        String   @id @default(uuid())
  planId    String
  action    String // add | bulk_add | remove | reorder | duplicate | update | served | plan_update
  detail    String   @db.Text
  userId    String? // sem relação, mesmo padrão dos outros campos de autoria daqui
  userName  String? // snapshot: o log tem que continuar legível se o usuário for removido
  createdAt DateTime @default(now())

  plan KitchenServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

// Check de "já produzido" na visão da semana — o pessoal da cozinha vai marcando o que
// adiantou nos dias anteriores. Separado de KitchenServicePlanEntry.status ('served') de
// propósito: produzir antes e servir na hora são momentos diferentes, e a visão da semana
// existe justamente pra planejar produção sem depender de a sequência já estar montada.
model KitchenPrepCheck {
  id          String   @id @default(uuid())
  eventId     String
  eventItemId String? // pacote de origem; SetNull porque o item pode ser removido pelo sync
  itemName    String
  checkedAt   DateTime @default(now())
  checkedById String?
  checkedByName String?
  createdAt   DateTime @default(now())

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventItem EventItem? @relation(fields: [eventItemId], references: [id], onDelete: SetNull)

  // Um check por item por evento — marcar de novo é toggle, não duplica.
  @@unique([eventId, itemName])
  @@index([eventId])
  @@index([eventItemId])
}

// ============================================
// Degustação (integrada ao sistema de Eventos)
// ============================================
//
// Cada degustação É um Event de verdade (convidados, check-in, cronograma, portal do cliente
// — tudo reaproveitado sem mudança). Este model só guarda o que é EXTRA de uma degustação,
// seguindo o mesmo padrão de EventClosure/KitchenEventPlan acima: 1:1 lateral, não campo em
// Event. `event.degustacao !== null` é como qualquer tela sabe "isto é uma degustação".

model Degustacao {
  id         String  @id @default(uuid())
  eventId    String  @unique
  visibility String // 'publico' | 'contrato'
  productId  String? // o "menu" — produto com subitems, mesmo mecanismo do Finger Food

  maxGuests Int @default(4) // contratante + 3 convidados, default do pedido de negócio

  // Agrupamento de recorrência. Sem tabela própria de propósito: as N ocorrências nascem
  // todas de uma vez (decisão de produto — sem job/cron por trás), então só precisam de uma
  // chave compartilhada pra "ver as outras desta série"; não há nada além disso pra guardar.
  seriesId           String?
  seriesIndex        Int?
  seriesIntervalDays Int?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  links       DegustacaoLink[]
  enrollments DegustacaoEnrollment[]

  @@index([seriesId])
}

// Modo PÚBLICO: 1 link por entidade do Userp, ANCORADO numa ocorrência (degustacaoId) só pra
// achar a série (Degustacao.seriesId) — o link não trava nessa ocorrência específica. Ao abrir
// o link, o backend resolve dinamicamente "a próxima ocorrência aberta da série" (ou a própria
// ancorada, se não houver série); assim um único link sobrevive à recorrência inteira, sem
// precisar gerar um novo a cada data. Depois de inscrito uma vez (enrolledEventId setado), o
// link vira somente-leitura, mostrando a ocorrência confirmada — nunca deixa escolher outra
// nem reinscrever. O contato é resolvido consultando
// GET /api/userp-satelite/entidades/index.php?id=<userpEntidadeId> (mesmo Bearer token já usado
// pelo sync — ver getUserpToken() em sync-events.ts) — nome/telefone/email abaixo são um
// SNAPSHOT do momento da geração, não um espelho ao vivo do Userp.
model DegustacaoLink {
  id              String    @id @default(uuid())
  degustacaoId    String
  userpEntidadeId Int
  nome            String
  telefone        String?
  email           String?
  token           String    @unique @default(uuid()) // única credencial da URL pública
  enrolledEventId String?   // Event.id da ocorrência em que a pessoa de fato se inscreveu
  enrolledAt      DateTime?
  // Snapshot dos nomes informados na inscrição (POST .../guests) — guardado aqui em vez de só
  // nos Guest rows porque várias entidades podem se inscrever na MESMA ocorrência; sem isso não
  // dava pra saber quais Guest vieram deste link especificamente. Vazio enquanto "Pendente".
  enrolledGuestNames String[] @default([])
  // Observação interna da equipe sobre este convidado/link (ex.: "VIP, avisar recepção") —
  // NUNCA exposta na rota pública GET /degustacao-link/:token (que monta a resposta campo a
  // campo, sem spread do registro) nem na página pública do convidado.
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())

  degustacao    Degustacao @relation(fields: [degustacaoId], references: [id], onDelete: Cascade)
  enrolledEvent Event?     @relation("DegustacaoLinkEnrollment", fields: [enrolledEventId], references: [id])
  guests        Guest[]

  // Mesma regra de idempotência do sistema anterior: gerar de novo pra mesma
  // entidade+degustação não duplica, devolve conflito.
  @@unique([degustacaoId, userpEntidadeId])
  @@index([degustacaoId])
}

// Modo CONTRATO: registra que um cliente (autenticado pela sessão do PRÓPRIO evento já
// contratado, via clientToken) se inscreveu numa degustação. O vínculo de volta ao evento de
// origem é o que permite ao comercial ver "este lead do evento X degustou no dia Y" — os
// convidados de fato (nomes) são Guest rows comuns no Event DA DEGUSTAÇÃO, não neste model.
model DegustacaoEnrollment {
  id              String   @id @default(uuid())
  degustacaoId    String
  contractEventId String
  enrolledAt      DateTime @default(now())

  degustacao    Degustacao @relation(fields: [degustacaoId], references: [id], onDelete: Cascade)
  contractEvent Event      @relation("DegustacaoEnrollmentContract", fields: [contractEventId], references: [id], onDelete: Cascade)

  // Um cliente só se inscreve uma vez em cada ocorrência.
  @@unique([degustacaoId, contractEventId])
  @@index([degustacaoId])
}

// ============================================
// Kitchen Production Pipeline
// ============================================

// Kitchen planning status per event
// Status flow: pending → shopping_approved → planned → in_production → done
model KitchenEventPlan {
  id         String   @id @default(uuid())
  eventId    String   @unique
  employerId String
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employer Employer @relation(fields: [employerId], references: [id])

  @@index([employerId])
  @@index([status])
}

// A production run for one recipe; can cover multiple events (unified pre-prep)
model KitchenProductionBatch {
  id          String   @id @default(uuid())
  employerId  String
  recipeId    String
  phase       String // 'pre_prep' | 'day_of'
  scheduledAt DateTime
  targetQty   Float // total portions to produce
  producedQty Float    @default(0)
  status      String   @default("planned") // planned | in_progress | done
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer    Employer                 @relation(fields: [employerId], references: [id])
  recipe      KitchenRecipe            @relation(fields: [recipeId], references: [id])
  allocations KitchenBatchAllocation[]

  @@index([employerId])
  @@index([recipeId])
  @@index([scheduledAt])
}

// Portion split of a batch across events
model KitchenBatchAllocation {
  id       String  @id @default(uuid())
  batchId  String
  eventId  String
  menuId   String?
  quantity Float // portions for this event

  batch KitchenProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  event Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([batchId, eventId])
  @@index([batchId])
  @@index([eventId])
}

// ============================================
// Kitchen AI Production Plan
// ============================================

// A plan covers N days ahead and groups all recipe production needed
model KitchenProductionPlan {
  id         String   @id @default(uuid())
  employerId String
  status     String   @default("draft") // draft | approved | in_progress | done
  windowDays Int      @default(30) // days ahead this plan covers
  aiModel    String?
  aiNotes    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employer Employer                    @relation(fields: [employerId], references: [id])
  items    KitchenProductionPlanItem[]

  @@index([employerId])
  @@index([status])
  @@index([createdAt])
}

// One production run for one recipe on one date
model KitchenProductionPlanItem {
  id            String   @id @default(uuid())
  planId        String
  recipeId      String
  quantity      Float // total portions to produce
  scheduledDate DateTime
  phase         String // pre_prep | day_of
  estimatedCost Float    @default(0)
  validityHours Int      @default(48)
  reasoning     String?
  status        String   @default("pending") // pending | done
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan        KitchenProductionPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe      KitchenRecipe                 @relation(fields: [recipeId], references: [id])
  allocations KitchenProductionAllocation[]

  @@index([planId])
  @@index([recipeId])
  @@index([scheduledDate])
}

// Maps each plan item to the events it serves (for per-event cost)
model KitchenProductionAllocation {
  id         String @id @default(uuid())
  planItemId String
  eventId    String
  quantity   Float // portions for this event
  costShare  Float  @default(0) // R$ cost allocated to this event

  planItem KitchenProductionPlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  event    Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([planItemId, eventId])
  @@index([planItemId])
  @@index([eventId])
}

// ============================================
// Configurações de Integração
// ============================================

model UerpConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

// ============================================
// Encerramento de Evento e NPS Organizador
// ============================================

model EventClosure {
  id                  String   @id @default(uuid())
  eventId             String   @unique
  itensQuebrados      String?
  situacoesReportadas String?
  abContractedQty     Float?   // quantidade de A&B contratada (snapshot no encerramento)
  abCheckedInCount    Int?     // quantidade de convidados com check-in (snapshot no encerramento)
  abExcessQty         Float?   // excedente confirmado pelo operador para cobrança adicional
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event          Event               @relation(fields: [eventId], references: [id])
  attachments    ClosureAttachment[]
  npsOrganizador EventNPSOrganizador?

  @@index([eventId])
}

model ClosureAttachment {
  id         String   @id @default(uuid())
  closureId  String
  filename   String
  mimeType   String
  sizeBytes  Int
  dataBase64 String
  createdAt  DateTime @default(now())

  closure EventClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)

  @@index([closureId])
}

model EventNPSOrganizador {
  id             String    @id @default(uuid())
  closureId      String    @unique
  eventId        String    @unique
  token          String    @unique @default(uuid())
  score          Int?
  comentario     String?
  imagemBase64   String?
  respondenteName String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())

  closure EventClosure @relation(fields: [closureId], references: [id])
  event   Event        @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([token])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  responsavel String?
  contato     String?
  atendimento String?
  entrega     String?
  insumos     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// ============================================
// Pessoas do Evento (cadastro central)
// ============================================

model Person {
  id         String   @id @default(uuid())
  employerId String
  name       String
  cpf        String?
  whatsapp   String?
  photoUrl   String?
  // usuario_id devolvido pela Userp ao vincular esta pessoa a um contrato (POST
  // contratos/usuarios/create.php) — guardado pra não precisar relocalizar por CPF a cada
  // vínculo novo, e pra saber a quem enviar a foto (usuarios/update-foto.php).
  userpUsuarioId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employer           Employer             @relation(fields: [employerId], references: [id])
  eventLinks         EventMember[]
  professionalLinks  EventProfessional[]
  activitiesAssigned EventActivity[]      @relation("ActivityAssignedPerson")

  @@unique([employerId, cpf])
  @@index([employerId])
  @@index([cpf])
}

model EventMember {
  id        String   @id @default(uuid())
  eventId   String
  personId  String
  role      String
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([eventId])
}

// Profissionais contratados para o evento (fotógrafo, músico etc.) — cadastro central em
// Person, com check-in próprio, separado dos convidados.
model EventProfessional {
  id            String    @id @default(uuid())
  eventId       String
  personId      String
  role          String    // especialidade: Fotógrafo, Músico, DJ, etc.
  checkedInAt   DateTime?
  checkedInById String?
  createdAt     DateTime  @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([eventId])
  @@index([personId])
}

// ============================================
// Atividades do Evento
// ============================================

model EventActivity {
  id            String    @id @default(uuid())
  eventId         String
  title           String
  description     String?
  assignedToId    String?
  assignedPersonId String?
  createdById     String?
  dueAt           DateTime?
  status          String    @default("open")
  completedAt     DateTime?
  completedById   String?
  response        String?
  lastAlertAt     DateTime?
  alertFreqMinutes Int      @default(30)
  // Preenchido só quando a atividade nasceu de um VenueActivityTemplate (geração
  // automática) — null para atividade criada à mão. Usado pra nunca duplicar a mesma
  // atividade gerada duas vezes pro mesmo evento (checagem por eventId+sourceTemplateId).
  sourceTemplateId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedTo     User?               @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])
  assignedPerson Person?             @relation("ActivityAssignedPerson", fields: [assignedPersonId], references: [id])
  createdBy      User?               @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  completedBy    User?               @relation("ActivityCompletedBy", fields: [completedById], references: [id])
  sourceTemplate VenueActivityTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  files          EventActivityFile[]

  @@index([eventId])
  @@index([status])
  @@index([assignedPersonId])
  @@index([sourceTemplateId])
}

model EventActivityFile {
  id         String        @id @default(uuid())
  activityId String
  name       String
  mimeType   String
  sizeBytes  Int
  s3Key      String
  createdAt  DateTime      @default(now())

  activity EventActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model EventLayout {
  id              String   @id @default(uuid())
  eventId         String
  venueId         String?
  name            String   @default("Layout Padrão")
  elements        Json
  createdById     String?
  // True when the client made this layout themselves (via the client portal, optionally
  // starting from a copy of a staff layout) — distinct from createdById (a User, staff-only).
  // A client may only edit/delete layouts where this is true, never a staff-authored one.
  createdByClient Boolean  @default(false)
  isLocked        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id])

  @@index([eventId])
  @@index([venueId])
}

model EventLayoutConfig {
  id        String   @id @default("default")
  config    Json
  updatedAt DateTime @updatedAt
}

// ============================================
// Assistente de dados (chat IA — dashboard)
// ============================================

model AiChatThread {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId])
}

model AiChatMessage {
  id        String   @id @default(uuid())
  threadId  String
  role      String   // user | assistant
  content   String   @db.Text
  toolTrace Json?    // consultas SQL rodadas + nº de linhas — só transparência/debug
  createdAt DateTime @default(now())

  thread AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// Fatos/regras de negócio que a IA aprende durante as conversas (ex.: "evento fechado
// = Event sem EventClosure associado") — incluídos no prompt de toda conversa futura
// (routes/ai-chat.ts buildSystemPrompt), crescendo com o uso em vez de precisar mudar
// código a cada nova regra descoberta.
model AiKnowledge {
  id        String   @id @default(uuid())
  fact      String   @db.Text
  createdAt DateTime @default(now())
}
