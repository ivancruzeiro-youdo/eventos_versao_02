// ============================================
// Produtos (importados do Userp-Satélite)
// ============================================

model Product {
  id              String   @id @default(uuid())
  externalId      String   @unique
  name            String
  descriptionLong String?
  subitems        Json?
  price           Float?
  categoryId      String?
  categoryName    String?
  unitId          String?
  unitName        String?
  unitAbbr        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions  ProductQuestion[]
  services   ProductServiceLink[]
  eventItems EventItem[]

  kitchenRecipes KitchenRecipe[]
  degustacoes    Degustacao[]

  @@index([categoryName])
}

model ProductQuestion {
  id        String       @id @default(uuid())
  productId String
  text      String
  type      QuestionType
  required  Boolean      @default(false)
  options   Json?
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  answers EventItemAnswer[]

  @@index([productId])
}

// ============================================
// Importação de Contratos Userp
// ============================================

model EventContract {
  id              String   @id @default(uuid())
  eventId         String
  // Único por natureza: uma linha por contrato do Userp. Sem essa trava, um contrato podia
  // ser vinculado a dois eventos e o sync criava duplicatas sem nada barrar.
  externalId      String   @unique // contrato_id from Userp
  clientCode      String   // cliente_codigo
  startDate       String   // data_inicio (YYYY-MM-DD) — matches events
  rawJson         Json     // full contract payload snapshot
  createdAt       DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  users EventContractUser[]

  @@index([eventId])
  @@index([clientCode, startDate])
}

// Usuário vinculado ao contrato no Userp (tb_loca_contrato_usuarios + tb_usuarios) — não é
// staff nem convidado do evento, é um contato/acesso do lado do cliente (ex.: cônjuge com
// acesso ao app). Vem do endpoint de LISTAGEM de contratos (contratos/index.php), não do
// endpoint de detalhe usado pelo resto do sync — por isso é sincronizado à parte, em
// syncContractUsers() (sync-events.ts). Exibido na aba "Pessoas" do evento, só leitura.
model EventContractUser {
  id               String   @id @default(uuid())
  eventContractId  String
  usuarioId        Int      // tb_usuarios.usr_id
  contUserId       Int      // tb_loca_contrato_usuarios.contuser_id — id do vínculo em si
  nome             String
  telefone         String?
  email            String?
  documento        String?
  acessaApp        Boolean  @default(false)
  acessaUnidade    Boolean  @default(false)
  acessoConsultivo Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  eventContract EventContract @relation(fields: [eventContractId], references: [id], onDelete: Cascade)

  @@unique([eventContractId, usuarioId])
  @@index([eventContractId])
}

// Item contratado dentro de um evento (A&B, Infraestrutura, Equipe, Locação)
model EventItem {
  id               String   @id @default(uuid())
  eventId          String
  productId        String?  // linked Product (null for venue items)
  venueId          String?  // linked Venue (for locação)
  sourceContractId String?  // external contract ID that contributed this item
  category         String   // "ab" | "infra" | "staff" | "venue"
  name             String
  quantity         Float    @default(1)
  unit             String?
  notes            String?
  occurrenceIndex  Int      @default(0)

  // Horário de serviço do item (usado em A&B) — editável na aba A&B / Plano do Evento e
  // exibido no cronograma como merge visual. NÃO gera linha em EventSchedule: aquele model
  // exige teamId, recusa sobreposição entre times com 409 e dispara WhatsApp pro time.
  // Nome com prefixo "service" porque startAt/endAt já significam outra coisa em Event e
  // EventSchedule. O sync do Userp não sobrescreve esses campos (sync-events.ts, caminho de
  // update escreve só quantity/name/unit/sourceContractId).
  serviceStartAt          DateTime?
  serviceEndAt            DateTime?
  serviceTimesUpdatedAt   DateTime?
  serviceTimesUpdatedById String?  // sem relação, mesmo padrão do venueId acima

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product  Product?       @relation(fields: [productId], references: [id])
  choices  EventItemChoice[]
  slots    EventStaffSlot[]
  answers  EventItemAnswer[]
  comments EventComment[]

  kitchenMenuLink    KitchenEventMenu[]
  servicePlanEntries KitchenServicePlanEntry[]
  prepChecks         KitchenPrepCheck[]

  @@index([eventId])
  @@index([productId])
  @@index([serviceStartAt])
}

// Escolhas feitas pelo cliente dentro de um item (ex: pratos selecionados)
model EventItemChoice {
  id            String    @id @default(uuid())
  eventItemId   String
  label         String    // subitem group label
  chosen        String[]  // chosen options from subitems
  maxChoices    Int?
  confirmedAt   DateTime?
  confirmedById String?

  eventItem   EventItem               @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  confirmedBy User?                   @relation("ChoiceConfirmedBy", fields: [confirmedById], references: [id])
  history     EventItemChoiceHistory[]

  @@index([eventItemId])
}

// Histórico de alterações em escolhas
model EventItemChoiceHistory {
  id        String   @id @default(uuid())
  choiceId  String
  before    String[] // previous chosen values
  after     String[] // new chosen values
  userId    String?
  createdAt DateTime @default(now())

  choice EventItemChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  user   User?           @relation("ChoiceHistoryUser", fields: [userId], references: [id])

  @@index([choiceId])
  @@index([createdAt])
}

// Respostas às perguntas de configuração de um item
model EventItemAnswer {
  id          String   @id @default(uuid())
  eventItemId String
  questionId  String
  answer      Json     // string | string[]
  updatedAt   DateTime @updatedAt
  updatedById String?

  eventItem   EventItem       @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  question    ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  updatedBy   User?           @relation("AnswerUpdatedBy", fields: [updatedById], references: [id])
  history     EventItemAnswerHistory[]

  @@unique([eventItemId, questionId])
  @@index([eventItemId])
}

// Histórico de alterações em respostas
model EventItemAnswerHistory {
  id        String   @id @default(uuid())
  answerId  String
  before    Json?
  after     Json
  userId    String?
  createdAt DateTime @default(now())

  answer EventItemAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User?           @relation("AnswerHistoryUser", fields: [userId], references: [id])

  @@index([answerId])
  @@index([createdAt])
}

// Vaga de freelancer criada a partir de item do tipo "staff"
model EventStaffSlot {
  id            String   @id @default(uuid())
  eventItemId   String
  serviceId     String   // FreelancerService
  quantity      Int      @default(1)
  filledCount   Int      @default(0)
  createdAt     DateTime @default(now())

  eventItem EventItem @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  @@index([eventItemId])
}

// Log de versão: toda sync gera um registro
model EventSyncLog {
  id          String   @id @default(uuid())
  eventId     String?
  action      String
  diff        Json?
  syncedAt    DateTime @default(now())
  triggeredBy String?

  event Event? @relation("EventToSyncLog", fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

// ============================================
// Módulo Cozinha
// ============================================

enum KitchenStorageType {
  dry
  frozen
  refrigerated
}

enum KitchenMenuType {
  guest
  staff
}

enum KitchenPurchaseSource {
  foto
  manual
}

model KitchenIngredient {
  id            String             @id @default(uuid())
  employerId    String
  name          String
  category      String
  unit          String
  costPerUnit   Float              @default(0)
  stockQuantity Float              @default(0)
  minQuantity   Float              @default(0)
  storageType   KitchenStorageType @default(dry)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  employer          Employer                  @relation(fields: [employerId], references: [id])
  recipeIngredients KitchenRecipeIngredient[]
  purchaseItems     KitchenPurchaseItem[]

  @@unique([employerId, name, unit])
  @@index([employerId])
