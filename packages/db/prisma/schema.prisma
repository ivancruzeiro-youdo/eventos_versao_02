generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Entidades de Usuários e Autenticação
// ============================================

enum UserRole {
  admin
  event_owner
  operator
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  role        UserRole
  employerId  String?
  userpCodigo String?  @unique
  userpTipo   String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer    Employer?   @relation(fields: [employerId], references: [id])
  auditLogs     AuditLog[]
  checkins      Guest[]     @relation("CheckedInBy")
  penaltiesApplied FreelancerPenalty[] @relation("AppliedBy")
  checklistItems ChecklistItem[] @relation("DoneBy")
  comments         EventComment[]
  deletedComments  EventComment[]   @relation("CommentDeletedBy")
  uploadedFiles File[] @relation("uploadedBy")
  choiceConfirmed       EventItemChoice[]         @relation("ChoiceConfirmedBy")
  choiceHistories       EventItemChoiceHistory[]   @relation("ChoiceHistoryUser")
  itemAnswers           EventItemAnswer[]          @relation("AnswerUpdatedBy")
  itemAnswerHistories   EventItemAnswerHistory[]   @relation("AnswerHistoryUser")
  venueAnswers         EventVenueAnswer[]         @relation("VenueAnswerUpdatedBy")
  venueAnswerHistories EventVenueAnswerHistory[]  @relation("VenueAnswerHistoryUser")
  activitiesCreated   EventActivity[]            @relation("ActivityCreatedBy")
  activitiesAssigned  EventActivity[]            @relation("ActivityAssignedTo")
  activitiesCompleted EventActivity[]            @relation("ActivityCompletedBy")
  teamMemberships     TeamMember[]
  aiChatThreads       AiChatThread[]
  venueActivityTemplatesDefault VenueActivityTemplate[] @relation("VenueActivityTemplateDefaultAssignee")

  @@index([email])
  @@index([employerId])
  @@index([userpCodigo])
}

model Freelancer {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  cpf          String           @unique
  phone        String?
  birthDate    DateTime?
  passwordHash String?
  status       FreelancerStatus @default(active)
  strikeCount  Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  fotoBase64   String?
  applications FreelancerApplication[]
  penalties    FreelancerPenalty[]
  services     FreelancerServiceLink[]
  acessoLogs   AcessoLog[]

  @@index([email])
  @@index([cpf])
}

model FreelancerService {
  id                  String   @id @default(uuid())
  name                String
  hourlyRate          Float    @default(0)
  description         String?
  startOffsetMinutes  Int      @default(-60)
  endOffsetMinutes    Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  freelancers    FreelancerServiceLink[]
  products       ProductServiceLink[]
  eventServices  EventService[]
  acessoMappings ServiceAcessoMapping[]
  teams          Team[]
}

model FreelancerServiceLink {
  id           String   @id @default(uuid())
  freelancerId String
  serviceId    String
  createdAt    DateTime @default(now())

  freelancer Freelancer        @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  service    FreelancerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, serviceId])
  @@index([freelancerId])
  @@index([serviceId])
}

model ProductServiceLink {
  id        String   @id @default(uuid())
  productId String
  serviceId String
  createdAt DateTime @default(now())

  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  service FreelancerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([productId, serviceId])
  @@index([productId])
  @@index([serviceId])
}

enum FreelancerStatus {
  active
  suspended
}

model Employer {
  id           String   @id @default(uuid())
  name         String
  cnpj         String?  @unique
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users   User[]
  events  Event[]
  venues  Venue[]
  services Service[]
  people  Person[]

  kitchenIngredients     KitchenIngredient[]
  kitchenRecipes         KitchenRecipe[]
  kitchenPurchases       KitchenPurchaseRecord[]
  kitchenLaborRoles      KitchenLaborRole[]
  kitchenEventPlans      KitchenEventPlan[]
  kitchenBatches         KitchenProductionBatch[]
  kitchenProductionPlans KitchenProductionPlan[]

  @@index([cnpj])
}

// ============================================
// Entidades de Eventos
// ============================================

enum EventStatus {
  draft
  confirmed
  in_progress
  completed
  encerrado
  cancelled
}

model Event {
  id                String      @id @default(uuid())
  name              String
  publicName        String?
  clientName        String
  employerId        String
  status            EventStatus @default(draft)
  setupAt           DateTime?
  startAt           DateTime?
  teardownAt        DateTime?
  checkoutAt        DateTime?
  notes             String?
  clientToken       String?     @unique
  reservationNumber String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  employer     Employer     @relation(fields: [employerId], references: [id])
  venues       EventVenue[]
  guests       Guest[]
  parkingEntries ParkingEntry[]
  professionals EventProfessional[]
  services     EventService[]
  plan         EventPlan?
  briefing     Briefing?
  checklists   EventChecklist[]
  applications FreelancerApplication[]
  nps          EventNPS[]
  files        File[]
  comments     EventComment[]
  schedules    EventSchedule[]
  contracts    EventContract[]
  items        EventItem[]
  syncLogs        EventSyncLog[]  @relation("EventToSyncLog")
  venueAnswers    EventVenueAnswer[]
  closure         EventClosure?
  members         EventMember[]
  npsOrganizador  EventNPSOrganizador?
  clientApprovals ClientApproval[]

  activities            EventActivity[]
  layouts               EventLayout[]
  kitchenMenus          KitchenEventMenu[]
  kitchenLabors         KitchenEventLabor[]
  productions           KitchenProductionLog[]
  kitchenPlan           KitchenEventPlan?
  kitchenServicePlan    KitchenServicePlan?
  kitchenPrepChecks     KitchenPrepCheck[]
  batchAllocations      KitchenBatchAllocation[]
  productionAllocations KitchenProductionAllocation[]
  mediaAssets           EventMediaAsset[]

  // Degustação: presente só quando este Event É uma ocorrência de degustação (padrão de
  // "característica extra" 1:1 já usado por closure/kitchenPlan acima — uma tela sabe "isto é
  // degustação" checando event.degustacao !== null, sem precisar de enum novo em Event).
  degustacao                   Degustacao?
  degustacaoEnrollmentsAsContract DegustacaoEnrollment[] @relation("DegustacaoEnrollmentContract")
  degustacaoLinkEnrollments    DegustacaoLink[] @relation("DegustacaoLinkEnrollment")

  @@index([employerId])
  @@index([status])
  @@index([startAt])
}

model EventVenue {
  id       String @id @default(uuid())
  eventId  String
  venueId  String
  notes    String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id])

  spotifyPlaylists EventVenueSpotifyPlaylist[]

  @@index([eventId])
  @@index([venueId])
}

// N playlists per event+venue (not just one) — each with an operator-facing comment
// (e.g. "tocar no jantar", "reserva pro final da festa"), shown on the Windows app's
// ControlWindow (tela 1) so whoever's running the show knows which one to pick and why.
// Order controls display order in that list, not playback order (nothing auto-advances
// between playlists — the operator picks one at a time).
model EventVenueSpotifyPlaylist {
  id                  String   @id @default(uuid())
  eventVenueId        String
  spotifyPlaylistId   String
  spotifyPlaylistName String
  comment             String?
  order               Int      @default(0)
  createdAt           DateTime @default(now())

  eventVenue EventVenue @relation(fields: [eventVenueId], references: [id], onDelete: Cascade)

  @@index([eventVenueId])
}

model Venue {
  id             String   @id @default(uuid())
  externalId     String?  @unique
  name           String
  address        String?
  city           String?
  state          String?
  capacity       Int?
  contactName    String?
  contactPhone   String?
  // Cor do local no calendário de eventos (hex, ex. "#3b82f6") — mostrada como borda do evento;
  // evento com 2+ locais mostra a borda dividida entre as cores de cada um.
  color          String?
  employerId     String
  floorPlanS3Key        String?
  floorPlanWidthMeters  Float?
  floorPlanHeightMeters Float?
  layoutStock           Json?
  createdAt             DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employer         Employer               @relation(fields: [employerId], references: [id])
  events           EventVenue[]
  questions        VenueQuestion[]
  layoutTemplates  VenueLayoutTemplate[]
  eventLayouts     EventLayout[]
  devices          VenueDevice[]
  spotifyConnection VenueSpotifyConnection?
  activityTemplates VenueActivityTemplate[]

  @@index([employerId])
}

// Atividade obrigatória de um espaço, replicada como EventActivity de verdade sempre que um
// evento novo é vinculado a esse espaço (com check-in/setupAt definido) — mesmo padrão de
// "template replicado por evento" já usado por VenueQuestion/EventVenueAnswer.
model VenueActivityTemplate {
  id                         String   @id @default(uuid())
  venueId                    String
  title                      String
  description                String?
  offsetMinutesBeforeCheckIn Int
  defaultAssignedToId        String?
  alertFreqMinutes           Int      @default(30)
  active                     Boolean  @default(true)
  order                      Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  venue               Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  defaultAssignedTo   User?           @relation("VenueActivityTemplateDefaultAssignee", fields: [defaultAssignedToId], references: [id])
  generatedActivities EventActivity[]

  @@index([venueId])
}

// One Spotify account connected per venue (OAuth authorization-code flow — see
// apps/api/src/routes/spotify.ts). Tokens are encrypted at rest (lib/crypto.ts) since a
// refresh token is a long-lived credential; unlike VenueDevice.deviceToken or
// UerpConfig, this is genuinely sensitive enough to be worth the extra layer.
model VenueSpotifyConnection {
  id                    String   @id @default(uuid())
  venueId               String   @unique
  spotifyUserId         String
  displayName           String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  scope                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

// Client ID/Secret of the ONE Spotify app registered at developer.spotify.com/dashboard —
// shared across all venues (each venue's OAuth authorization produces its own
// VenueSpotifyConnection tokens, but they all authorize against this same app).
// Singleton table, same shape/rationale as UerpConfig: an admin pastes these in via
// Sistemas → Integrações → Spotify instead of an env var, no server access needed.
model SpotifyAppConfig {
  id           String   @id @default(uuid())
  clientId     String
  clientSecret String
  updatedAt    DateTime @updatedAt
}

// ============================================
// Mídia (painel de LED) + Spotify por espaço
// ============================================

// A physical Windows install (LED-panel controller) paired to one venue.
// Authenticates via a long-lived JWT (deviceToken claim), no User row involved —
// mirrors the client-portal pattern (see getClientSession in routes/client.ts).
model VenueDevice {
  id                  String    @id @default(uuid())
  venueId             String
  name                String
  pairingCode         String?   @unique
  pairingCodeExpiresAt DateTime?
  deviceToken         String?   @unique
  status              String    @default("pending") // pending | active | revoked
  lastSeenAt          DateTime?
  createdAt           DateTime  @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

// Video/image/audio uploaded specifically for one event, played back on the venue's
// LED panel via the paired VenueDevice's local cache (offline after sync).
model EventMediaAsset {
  id          String    @id @default(uuid())
  eventId     String
  name        String
  mediaType   String    // video | image | audio
  s3Key       String?   // null once deletedAt is set — the S3 object is gone
  mimeType    String
  sizeBytes   Int
  durationSec Float?
  checksum    String
  order       Int       @default(0)
  comment     String?   // operator-facing note, e.g. "usar às 20h" / "tocar na abertura"
  deletedAt   DateTime? // set by the retention worker (20 days after event closure) — row kept as a record
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// A published build of the Windows LED-panel app (desktop/led-controller), listed on
// the "Sistemas → Downloads" page and polled by the app itself on every startup
// (GET /devices/latest-version, public — the app needs this before it necessarily has
// a paired session) to self-update.
// systemKey identifies which downloadable app this release belongs to (the "Sistemas →
// Downloads" page groups by this) — e.g. "led-controller" for the LED-panel Windows app.
// Not an enum: new systems just start using a new key, no schema change needed. Version
// uniqueness is scoped per system, not global, since two different systems' version
// numbers are unrelated (e.g. both could legitimately publish a "1.0.0").
model DesktopRelease {
  id           String   @id @default(uuid())
  systemKey    String   @default("led-controller")
  systemLabel  String   @default("Painel de LED (Windows)") // shown on the Downloads page
  version      String   // e.g. "1.2.0" — compared as System.Version on the client
  s3Key        String
  sizeBytes    Int
  releaseNotes String?
  createdAt    DateTime @default(now())

  @@unique([systemKey, version])
  @@index([systemKey])
}

model VenueLayoutTemplate {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  elements  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model VenueQuestion {
  id        String       @id @default(uuid())
  venueId   String
  text      String
  type      QuestionType
  required  Boolean      @default(false)
  options   Json?
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  venue   Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  answers EventVenueAnswer[]

  @@index([venueId])
}

model EventVenueAnswer {
  id         String    @id @default(uuid())
  eventId    String
  questionId String
  answer     Json
  updatedAt  DateTime  @updatedAt
  updatedById String?

  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question   VenueQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  updatedBy  User?         @relation("VenueAnswerUpdatedBy", fields: [updatedById], references: [id])
  history    EventVenueAnswerHistory[]

  @@unique([eventId, questionId])
  @@index([eventId])
}

model EventVenueAnswerHistory {
  id        String   @id @default(uuid())
  answerId  String
  before    Json?
  after     Json
  userId    String?
  createdAt DateTime @default(now())

  answer EventVenueAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User?            @relation("VenueAnswerHistoryUser", fields: [userId], references: [id])

  @@index([answerId])
}

// ============================================
// Entidades de Convidados
// ============================================

enum GuestStatus {
  pending
  confirmed
  declined
  waitlisted
  checked_in
}

model Guest {
  id               String      @id @default(uuid())
  eventId          String
  name             String
  phone            String?
  cpf              String?
  email            String?
  status           GuestStatus @default(pending)
  rsvpToken        String?     @unique
  rsvpRespondedAt  DateTime?
  checkedInAt      DateTime?
  checkedInByUserId String?
  isMinor          Boolean     @default(false)
  responsibleName  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Presente só quando este Guest veio de uma inscrição por link de degustação — é o que
  // permite editar/remover convidados de UM link específico sem afetar outros que se
  // inscreveram na mesma ocorrência (ver DegustacaoLink).
  degustacaoLinkId String?

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInBy User?   @relation("CheckedInBy", fields: [checkedInByUserId], references: [id])
  degustacaoLink DegustacaoLink? @relation(fields: [degustacaoLinkId], references: [id], onDelete: SetNull)
  nps       EventNPS?
  parkingEntries ParkingEntry[]

  @@index([eventId])
  @@index([status])
  @@index([cpf])
  @@index([rsvpToken])
  @@index([degustacaoLinkId])
}

model ParkingEntry {
  id                 String   @id @default(uuid())
  eventId            String
  guestId            String
  guestName          String   // snapshot no momento do registro
  photoS3Key         String
  registeredById      String? // id do freelancer/usuário que registrou (recepção)
  registeredByName   String?
  createdAt          DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([guestId])
}

// ============================================
// Entidades de Freelancers
// ============================================

model FreelancerApplication {
  id           String                   @id @default(uuid())
  freelancerId String
  eventId      String
  role         String
  status       ApplicationStatus      @default(pending)
  appliedAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  freelancer Freelancer @relation(fields: [freelancerId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  acessoLogs AcessoLog[]

  @@index([freelancerId])
  @@index([eventId])
  @@index([status])
}

// ============================================
// Integração com Sistema de Acessos
// ============================================

model ServiceAcessoMapping {
  id         String   @id @default(uuid())
  serviceId  String
  acessoId   String
  acessoNome String?
  createdAt  DateTime @default(now())

  service FreelancerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, acessoId])
  @@index([serviceId])
}

model AcessoLog {
  id              String   @id @default(uuid())
  freelancerId    String
  applicationId   String
  acessoExternoId String?
  status          String
  payload         Json?
  response        Json?
  createdAt       DateTime @default(now())

  freelancer  Freelancer            @relation(fields: [freelancerId], references: [id])
  application FreelancerApplication @relation(fields: [applicationId], references: [id])

  @@index([freelancerId])
  @@index([applicationId])
  @@index([status])
}

enum ApplicationStatus {
  pending
  approved
  rejected
  cancelled
}

model FreelancerPenalty {
  id            String   @id @default(uuid())
  freelancerId  String
  eventId       String?
  reason        String
  severity      PenaltySeverity
  appliedByUserId String
  createdAt     DateTime @default(now())

  freelancer Freelancer @relation(fields: [freelancerId], references: [id])
  appliedBy  User       @relation("AppliedBy", fields: [appliedByUserId], references: [id])

  @@index([freelancerId])
}

enum PenaltySeverity {
  light
  medium
  grave
}

// ============================================
// Entidades de Planos
// ============================================

model EventPlan {
  id        String     @id @default(uuid())
  eventId   String     @unique
  title     String
  status    PlanStatus @default(draft)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions PlanQuestion[]
}

enum PlanStatus {
  draft
  completed
}

model PlanQuestion {
  id        String           @id @default(uuid())
  planId    String
  text      String
  type      QuestionType
  required  Boolean          @default(false)
  order     Int
  productId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  plan    EventPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  answers PlanAnswer[]

  @@index([planId])
}

enum QuestionType {
  text
  textarea
  select
  multiselect
  checkbox
  date
  number
}

model PlanAnswer {
  id              String   @id @default(uuid())
  questionId      String
  textValue       String?
  selectedOptions Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question PlanQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ============================================
// Entidades de Briefing
// ============================================

model Briefing {
  id         String          @id @default(uuid())
  eventId    String          @unique
  templateId String?
  status     BriefingStatus  @default(draft)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions BriefingQuestion[]
}

enum BriefingStatus {
  draft
  completed
}

model BriefingQuestion {
  id         String           @id @default(uuid())
  briefingId String
  text       String
  type       QuestionType
  required   Boolean          @default(false)
  order      Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  briefing Briefing        @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  answers  BriefingAnswer[]

  @@index([briefingId])
}

model BriefingAnswer {
  id         String   @id @default(uuid())
  questionId String
  value      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question BriefingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ============================================
// Entidades de Serviços
// ============================================

model Service {
  id          String   @id @default(uuid())
  name        String
  category    String?
  description String?
  employerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer Employer? @relation(fields: [employerId], references: [id])
}

model EventService {
  id           String    @id @default(uuid())
  code         Int       @unique @default(autoincrement()) // sequential "vaga" number shown to freelancers (e.g. #350)
  eventId      String
  serviceId    String
  productName  String?
  notes        String?
  status       String    @default("active")
  startAt      DateTime?
  endAt        DateTime?
  valuePerHour Float     @default(0)
  maxSlots     Int       @default(1)
  createdAt    DateTime  @default(now())

  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service         FreelancerService       @relation(fields: [serviceId], references: [id])
  files           File[]
  linkedChecklists EventServiceChecklist[]

  @@index([eventId])
  @@index([serviceId])
}

model EventServiceChecklist {
  serviceId   String
  checklistId String

  service   EventService   @relation(fields: [serviceId],   references: [id], onDelete: Cascade)
  checklist EventChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@id([serviceId, checklistId])
}

// ============================================
// Entidades de Checklists
// ============================================

model EventChecklist {
  id         String   @id @default(uuid())
  eventId    String
  title      String
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items           ChecklistItem[]
  linkedServices  EventServiceChecklist[]

  @@index([eventId])
}

model ChecklistItem {
  id            String    @id @default(uuid())
  checklistId   String
  text          String
  done          Boolean   @default(false)
  doneAt        DateTime?
  doneByUserId  String?
  order         Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checklist EventChecklist? @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy    User?      @relation("DoneBy", fields: [doneByUserId], references: [id])

  @@index([checklistId])
}

model ChecklistTemplate {
  id          String                  @id @default(uuid())
  title       String
  employerId  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  items ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id          String            @id @default(uuid())
  templateId  String
  text        String
  order       Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// ============================================
// Entidades de NPS
// ============================================

model EventNPS {
  id          String   @id @default(uuid())
  eventId     String
  guestId     String   @unique
  score       Int?
  comment     String?
  submittedAt DateTime?
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ============================================
// Entidades de Cronograma
// ============================================

model EventSchedule {
  id          String   @id @default(uuid())
  eventId     String
  teamId      String?
  name        String
  startAt     DateTime
  endAt       DateTime
  description String?
  fileId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team?          @relation(fields: [teamId], references: [id])
  file    File?          @relation("ScheduleFile", fields: [fileId], references: [id])
  history EventComment[]

  @@index([eventId])
  @@index([teamId])
  @@index([startAt])
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  serviceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service   FreelancerService? @relation(fields: [serviceId], references: [id])
  schedules EventSchedule[]
  members   TeamMember[]

  @@index([serviceId])
}

// Vincula usuários (User) a um Team — quem recebe alerta via WhatsApp quando uma
// atividade do cronograma (EventSchedule) daquele time é criada/alterada.
model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ============================================
// Entidades de Arquivos e Logs
// ============================================

model File {
  id               String   @id @default(uuid())
  eventId          String
  serviceId        String?
  uploadedByUserId String?
  name             String
  mimeType         String
  sizeBytes        Int
  s3Key            String
  comment          String?
  visibleToClient  Boolean  @default(false)
  createdAt        DateTime @default(now())

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service     EventService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploadedBy  User?         @relation("uploadedBy", fields: [uploadedByUserId], references: [id])
  schedules   EventSchedule[] @relation("ScheduleFile")

  @@index([eventId])
  @@index([serviceId])
}

// ============================================
// Entidades de Comentários
// ============================================

model EventComment {
  id              String    @id @default(uuid())
  eventId         String
  eventItemId     String?   // null = event-level comment; set = item-level comment
  eventScheduleId String?   // set = schedule history entry
  userId          String?   // null for system auto-comments
  isSystem        Boolean   @default(false)
  content         String
  deletedAt       DateTime? // soft-delete: keeps record in history
  deletedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventItem     EventItem?     @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  eventSchedule EventSchedule? @relation(fields: [eventScheduleId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id])
  deletedBy     User?          @relation("CommentDeletedBy", fields: [deletedById], references: [id])

  @@index([eventId])
  @@index([eventItemId])
  @@index([eventScheduleId])
  @@index([userId])
}

model ClientApproval {
  id         String   @id @default(uuid())
  eventId    String
  itemType   String   // 'plan' | 'schedule'
  itemId     String
  approvedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, itemType, itemId])
  @@index([eventId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

// ============================================
// Entidades de Templates
// ============================================

model TemplateQuestion {
  id          String       @id @default(uuid())
  text        String
  type        QuestionType
  required    Boolean      @default(false)
  productId   String?
  categoryId  String?
  employerId  String?
