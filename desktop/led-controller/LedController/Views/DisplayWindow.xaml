<Window x:Class="LedController.Views.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouDO — Painel de LED"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Black"
        ShowInTaskbar="False">
    <Grid>
        <!-- Idle slate — shown when nothing is selected on the control window -->
        <TextBlock x:Name="IdleText" Text="YouDO" Foreground="#333" FontSize="48" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Image x:Name="ImageDisplay" Stretch="Uniform" Visibility="Collapsed"/>

        <MediaElement x:Name="VideoDisplay" Stretch="Uniform" Visibility="Collapsed"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False"/>
    </Grid>
</Window>
