<Window x:Class="LedController.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouDO — Controle do Painel de LED"
        Width="1180" Height="720" MinWidth="960" MinHeight="600"
        WindowStartupLocation="Manual"
        Background="#0F131A"
        Foreground="#E2E4E9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- YouDO design-system tokens (dark palette), mirrored from apps/web/src/app/globals.css -->
        <SolidColorBrush x:Key="CardBrush" Color="#181D25"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#29303D"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#576DDB"/>
        <SolidColorBrush x:Key="DestructiveBrush" Color="#DC2828"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2EB877"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F96A3"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E2E4E9"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#232A36"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
        </Style>

        <!-- Full retemplate: the default ComboBox chrome ignores Background/Foreground on
             several WPF themes, leaving light system-chrome behind pale text — unreadable
             on this dark palette. This template routes every part through our brushes. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.BorderThickness>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderThickness>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260" Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Each row: name + up/down reorder buttons, since playback follows this order. -->
        <DataTemplate x:Key="MediaItemTemplate">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🖼 Imagem — sem áudio"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MediaType}" Value="video">
                                        <Setter Property="Text" Value="🎬 Vídeo — com áudio"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MediaType}" Value="audio">
                                        <Setter Property="Text" Value="🎵 Áudio"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="▲" Style="{StaticResource TinyButton}" Margin="6,0,4,0"
                        Tag="{Binding}" Click="MoveUp_Click"/>
                <Button Grid.Column="2" Content="▼" Style="{StaticResource TinyButton}"
                        Tag="{Binding}" Click="MoveDown_Click"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Header card: branding, device identity, sync status, window-level actions -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Source="Assets/youdo-logo-white.png" Height="28" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DeviceNameText" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="AppVersionText" FontSize="11" Margin="8,2,0,0" VerticalAlignment="Bottom"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       ToolTip="Versão do app — gerada automaticamente a cada build, então dá pra ver na hora se está desatualizado"/>
                        </StackPanel>
                        <TextBlock x:Name="SyncStatusText" Text="Sincronizando..." FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ReopenDisplayButton" Content="Reabrir tela 2" Margin="8,0,0,0"
                            Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}"
                            IsEnabled="False" Click="ReopenDisplayButton_Click"/>
                    <Button x:Name="CloseDisplayButton" Content="Fechar tela 2" Margin="8,0,0,0"
                            Style="{StaticResource GhostButton}" Click="CloseDisplayButton_Click"/>
                    <Button x:Name="SyncNowButton" Content="Sincronizar agora" Margin="8,0,0,0"
                            Style="{StaticResource ModernButton}" Background="{StaticResource PrimaryBrush}"
                            Click="SyncNowButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Event picker card -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="EVENTO ATUAL" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="EventSelector" SelectionChanged="EventSelector_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Bottom action bar: panel-wide overrides -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="StopButton" Content="Parar / Tela ociosa" Height="46"
                    Style="{StaticResource ModernButton}" Background="{StaticResource DestructiveBrush}"
                    Click="StopButton_Click"/>
            <Button Grid.Column="2" x:Name="BlackButton" Content="Preto" Height="46"
                    Style="{StaticResource ModernButton}" Background="#111418" Click="BlackButton_Click"/>
            <Button Grid.Column="4" x:Name="LogoButton" Content="Logo YouDO" Height="46"
                    Style="{StaticResource ModernButton}" Background="{StaticResource PrimaryBrush}"
                    Click="LogoButton_Click"/>
            <Button Grid.Column="6" x:Name="FillToggleButton" Content="Preencher tela (zoom)" Height="46"
                    Style="{StaticResource GhostButton}" Click="FillToggleButton_Click"/>
        </Grid>

        <!-- Main content: reorderable media list (left) + local preview before sending (right) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MÍDIAS DO EVENTO (ordem de exibição)"
                               Style="{StaticResource SectionLabel}"/>
                    <ListBox x:Name="MediaList" ItemTemplate="{StaticResource MediaItemTemplate}"
                             SelectionChanged="MediaList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PRÉVIA (SÓ NESTA TELA — NÃO VAI PRO PAINEL AINDA)"
                               Style="{StaticResource SectionLabel}"/>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="SendToDisplayButton" Content="Enviar para tela 2 →"
                                Height="46" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}"
                                IsEnabled="False" Click="SendToDisplayButton_Click"/>
                        <Button Grid.Column="2" x:Name="MuteButton" Content="🔊 Mutar" Height="46" Width="140"
                                Style="{StaticResource GhostButton}" Click="MuteButton_Click"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="AudioStatusText" Text="— Nada em exibição no painel"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0"/>

                    <Grid Background="Black">
                        <TextBlock x:Name="PreviewIdleText" Text="Selecione uma mídia à esquerda para pré-visualizar"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Width="240"/>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        <MediaElement x:Name="PreviewVideo" Stretch="Uniform" Visibility="Collapsed"
                                      LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
