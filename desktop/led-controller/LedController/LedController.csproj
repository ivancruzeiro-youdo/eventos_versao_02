<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.Screen (multi-monitor enumeration) — WPF has no
         native API to list physical monitors and place a window on a specific one. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LedController</RootNamespace>
    <AssemblyName>YouDoLedController</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <!-- Bump this on every release published via Sistemas → Downloads — UpdateService
         compares this (via Assembly.GetName().Version) against DesktopRelease.version
         from GET /devices/latest-version. Keep it a plain "Major.Minor.Patch". -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- UpdateService self-replaces the running .exe on startup, which only makes sense
         for a single portable file. Publish with (see README.md for the flag spelled
         out; XML comments can't contain a literal double dash):
         dotnet publish -c Release
         then upload the resulting YouDoLedController.exe via Sistemas → Downloads. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Presigned S3 URLs are plain HTTPS GETs — no extra AWS SDK dependency needed. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\youdo-logo.png" />
    <Resource Include="Assets\youdo-logo-white.png" />
  </ItemGroup>

</Project>
